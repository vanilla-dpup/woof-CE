download() {
    if [ ! -f gplaces-0.20.5.tar ]; then
        git clone https://github.com/dimkr/gplaces gplaces-0.20.5
        cd gplaces-0.20.5
        git checkout v0.20.5
        git submodule update --init --recursive
        cd ..
        rm -rf gplaces-0.20.5/.git* gplaces-0.20.5/bestline/.git*
        tar -c gplaces-0.20.5 --mtime=@0 --sort=name --owner=0 --group=0 --numeric-owner --format=ustar > gplaces-0.20.5.tar
        rm -rf gplaces-0.20.5
    fi
}

build() {
    tar -xf gplaces-0.20.5.tar
    cd gplaces-0.20.5
    make CC=gcc VERSION=0.20.5 CONFDIR=/etc install
    sed -i 's/^Categories=.*/Categories=X-Internet-utility;/' /usr/local/share/applications/gplaces.desktop
}
