<?xml version="1.0"?>

<labwc_config>
  <windowSwitcher show="yes" preview="no" outlines="yes">
    <fields>
      <field content="title" width="100%" />
    </fields>
  </windowSwitcher>

  <placement>
    <policy>cursor</policy>
  </placement>

  <resize>
    <drawContents>no</drawContents>
  </resize>

  <!-- set by ptheme-labwc -->
  <theme><name>Gradient-grey</name></theme>

  <theme>
    <icon>Adwaita</icon>
    <fallbackAppIcon>application-x-executable-symbolic</fallbackAppIcon>
    <cornerRadius>0</cornerRadius>
  </theme>

  <desktops number="3"/>

  <keyboard>
    <default />

    <keybind key="A-Up" />
    <keybind key="A-Down" />
    <!-- these collide with back/forward navigation in the browser -->
    <keybind key="A-Left" />
    <keybind key="A-Right" />

    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>

    <keybind key="W-Down">
      <action name="Iconify" />
    </keybind>

    <keybind key="C-A-Left">
      <action name="GoToDesktop" to="left" />
    </keybind>

    <keybind key="C-A-Right">
      <action name="GoToDesktop" to="right" />
    </keybind>

    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>

    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>

    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>

    <keybind key="XF86_AudioLowerVolume" allowWhenLocked="yes">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-" />
    </keybind>

    <keybind key="XF86_AudioRaiseVolume" allowWhenLocked="yes">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+" />
    </keybind>

    <keybind key="XF86_AudioMute" allowWhenLocked="yes">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>

    <keybind key="Print">
      <action name="Execute"><command>screenshot full</command></action>
    </keybind>

    <keybind key="S-Print">
      <action name="Execute"><command>screenshot region</command></action>
    </keybind>

    <keybind key="W-S-s">
      <action name="Execute"><command>screenshot region</command></action>
    </keybind>

    <keybind key="A-F1">
      <action name="ShowMenu"><menu>root-menu</menu></action>
    </keybind>

    <keybind key="A-F2">
      <action name="Execute"><command>gexec</command></action>
    </keybind>

    <keybind key="W-l">
      <action name="Execute"><command>swaylock</command></action>
    </keybind>

    <keybind key="W-r">
      <action name="Execute"><command>gexec</command></action>
    </keybind>

    <keybind key="W-e">
      <action name="Execute"><command>spacefm</command></action>
    </keybind>

    <keybind key="W-w">
      <action name="Execute"><command>x-www-browser</command></action>
    </keybind>

    <keybind key="C-A-t">
      <action name="Execute"><command>footclient</command></action>
    </keybind>

    <keybind key="C-A-Delete">
      <action name="Execute"><command>lxtask</command></action>
    </keybind>

    <keybind key="C-S-Escape">
      <action name="Execute"><command>lxtask</command></action>
    </keybind>
  </keyboard>

</labwc_config>