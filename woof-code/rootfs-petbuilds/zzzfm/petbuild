download() {
    [ -f zzzfm-bc7473cebcf3b4f932d82d82c044c68b8c78de58.zip ] || curl --fail --retry 3 --max-time 60 -o zzzfm-bc7473cebcf3b4f932d82d82c044c68b8c78de58.zip https://gitlab.com/antix-contribs/zzzfm/-/archive/bc7473cebcf3b4f932d82d82c044c68b8c78de58/zzzfm-bc7473cebcf3b4f932d82d82c044c68b8c78de58.zip
}

build() {
    unzip -q zzzfm-bc7473cebcf3b4f932d82d82c044c68b8c78de58.zip
    cd zzzfm-bc7473cebcf3b4f932d82d82c044c68b8c78de58
    patch -p1 < ../fix-ftbfs-gcc14.patch
    patch -p1 < ../wayland.patch
    patch -p1 < ../mount.patch
    patch -p1 < ../puppy-defaults.patch
    patch -p1 < ../layer-shell.patch
    patch -p1 < ../gcc15.patch
    ./autogen.sh --disable-video-thumbnails --with-gtk3 --with-layer-shell
    make install
    sed -e 's/^Categories=.*/Categories=FileManager/' -i /usr/local/share/applications/zzzfm.desktop
}
