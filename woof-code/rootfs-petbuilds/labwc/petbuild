download() {
    [ -f labwc-0.5.3.tar.gz ] || curl --fail --location --retry 3 --max-time 60 -o labwc-0.5.3.tar.gz https://github.com/labwc/labwc/archive/refs/tags/0.5.3.tar.gz
}

build() {
    tar -xzf labwc-0.5.3.tar.gz
    cd labwc-0.5.3
    meson --buildtype=release -Dxwayland=enabled build
    ninja -C build install
}
