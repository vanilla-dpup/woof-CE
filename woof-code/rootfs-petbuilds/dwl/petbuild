download() {
    [ -f dwl-2783d91611a027cfecc43a39689b6e589578a88b.tar.gz ] || curl --fail --retry 3 --max-time 60 -o dwl-2783d91611a027cfecc43a39689b6e589578a88b.tar.gz https://codeberg.org/dwl/dwl/archive/2783d91611a027cfecc43a39689b6e589578a88b.tar.gz
}

build() {
    tar -xzf dwl-2783d91611a027cfecc43a39689b6e589578a88b.tar.gz
    cd dwl
    patch -p1 < ../en-keycodes.patch
    patch -p1 < ../snail.patch
    patch -p1 < ../envcfg.patch
    patch -p1 < ../center.patch
    sed -e s/^#XWAYLAND/XWAYLAND/ -e s/^#XLIBS/XLIBS/ -i config.mk
    cp -f ../config.h .
    make install

    $CC $CFLAGS ../dwl-send.c $LDFLAGS -o /usr/local/bin/dwl-send
    $CC $CFLAGS ../dwl-status.c $LDFLAGS -o /usr/local/bin/dwl-status
}