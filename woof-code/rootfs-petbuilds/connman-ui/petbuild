download() {
    [ -f connman-ui_0~20150623.orig.tar.gz ] || wget -t 3 -T 60 -O connman-ui_0~20150623.orig.tar.gz https://deb.debian.org/debian/pool/main/c/connman-ui/connman-ui_0~20150623.orig.tar.gz
}

build() {
    tar -xzf connman-ui_0~20150623.orig.tar.gz
    cd connman-ui-0_20150622+dfsg.orig
    patch -p1 < ../grab.patch
    patch -p1 < ../no-label.patch
    ./autogen.sh
    ./configure --prefix=/usr
    make install

    for ICON in /usr/share/connman_ui_gtk/icons/*.png; do
        [ -f ../${ICON%.png}.svg ] || continue
        rm -f ${ICON}
    done
}