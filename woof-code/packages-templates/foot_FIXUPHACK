cat << EOF > etc/skel/.config/autostart/foot-server.desktop
[Desktop Entry]
Type=Application
Name=Foot server
NoDisplay=true
Exec=foot -s
EOF
chmod 644 etc/skel/.config/autostart/foot-server.desktop

mkdir -p etc/skel/.config/foot
cat << EOF > etc/skel/.config/foot/foot.ini
[main]
initial-window-size-chars = 80x24
font=monospace:size=10
[colors]
# https://github.com/lxde/lxterminal/pull/123
background = 000000
foreground = ffffff
regular0 = 000000
regular1 = ff6866
regular2 = 46bf00
regular3 = aba700
regular4 = 709dff
regular5 = d969f5
regular6 = 00b7be
regular7 = bcbcbc
bright0 = 777777
bright1 = ffb18f
bright2 = 00ed7b
bright3 = b5d900
bright4 = bbc0ff
bright5 = ffa5df
bright6 = 3cdbff
bright7 = ffffff
EOF
chmod 644 etc/skel/.config/foot/foot.ini
