mkdir -p etc/skel/.config/waybar/presets/{Top,Bottom,Left,Right}

cat << EOF > etc/skel/.config/waybar/presets/Top/config.jsonc
// -*- mode: jsonc -*-
[{
	"name": "bar1",
	"layer": "bottom",
	"position": "top",
	"height": 36,
	"margin-left": 42,
	"margin-right": 42,
	"spacing": 4,
	"modules-left": [
		"wlr/taskbar"
	],
	"modules-right": [
		"wireplumber",
		"battery",
		"network",
		"clock"
	],
	"wlr/taskbar": {
		"format": "{icon}",
		"icon-size": 24,
		"tooltip-format": "{title}",
		"on-click": "activate",
		"on-click-middle": "close"
	},
	"clock": {
		"format": "{:%H:%M}",
		"tooltip-format": "{:%Y-%m-%d}",
		"on-click": "gsimplecal"
	},
	"wireplumber": {
		"format": "\uf028 {volume}%",
		"format-muted": "\uf026 {volume}%",
		"on-click": "pavucontrol"
	},
	"battery": {
		"states": {
			"good": 90,
			"warning": 30,
			"critical": 10
		},
		"format": "{icon} {capacity}%",
		"format-charging": "\uf0e7 {capacity}%",
		"format-plugged": "\uf1e6 {capacity}%",
		"format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
		"on-click": "batinfo"
	},
	"network": {
		"format-wifi": "\uf1eb {signalStrength}%",
		"format-ethernet": "\uf0c1 wired",
		"format": "\uf127 offline",
		"tooltip-format": "{ifname}",
		"tooltip-format-wifi": "{essid}",
		"on-click": "connman-gtk"
	}
}]
EOF

cat << EOF > etc/skel/.config/waybar/presets/Top/style.css
* {
	font-family: FontAwesome, sans-serif;
	font-size: 14px;
}

.bar1 {
	background-color: #F6F5F4;
	color: #000000;
	border-bottom: 1px solid #DEDDDC;
}

button {
	background-color: #E1DEDB;
	border: none;
	border-radius: 0;
	border-top: 4px solid #E1DEDB;
	box-shadow: none;
}

button:hover {
	background: #EDEBE9;
	border-top: 4px solid #CDC7C2;
}

#taskbar button.active {
	background: #E1DEDB;
	border-top: 4px solid #3584E4;
}

#clock {
	padding: 4px;
}
EOF

