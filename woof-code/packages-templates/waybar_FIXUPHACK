cat << EOF > usr/local/bin/waybar-config
#!/bin/sh

PRESETS=
for PRESET in ~/.config/waybar/presets/*; do
	PRESETS="\$PRESETS \${PRESET##*/}"
done

while :; do
	CHOICE=\`yad --title waybar-config --window-icon=gtk-preferences --width=240 --height=240 --list --no-headers --column=theme --print-column=1 --separator= -- \$PRESETS\`
	[ -z "\$CHOICE" ] && break

	ln -sf presets/\${CHOICE}/config.jsonc ~/.config/waybar/config.jsonc
	ln -sf presets/\${CHOICE}/style.css ~/.config/waybar/style.css

	killall waybar
	waybar &
done
EOF
chmod 755 usr/local/bin/waybar-config

ln -s presets/Bottom/config.jsonc etc/skel/.config/waybar/config.jsonc
ln -s presets/Bottom/style.css etc/skel/.config/waybar/style.css

cat << EOF > usr/local/share/applications/waybar-config.desktop
[Desktop Entry]
Encoding=UTF-8
Name=Panel Settings
Icon=sidebar-show-symbolic
Comment=Change waybar preset
Exec=waybar-config
Terminal=false
Type=Application
Categories=X-Desktop-appearance
GenericName=waybar-config
EOF
