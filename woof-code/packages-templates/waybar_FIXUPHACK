mkdir -p etc/skel/.config/autostart
cat << EOF > etc/skel/.config/autostart/waybar.desktop
[Desktop Entry]
Encoding=UTF-8
Type=Application
NoDisplay=true
Name=waybar
Exec=waybar
EOF
