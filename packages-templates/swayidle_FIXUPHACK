cat << EOF > usr/local/bin/swayidle-config
#!/bin/bash

IFS=\| read wlopm_interval psuspend_interval < <(yad --title swayidle-config --window-icon=user-idle-symbolic --form --field="Idle interval (seconds)" \`grep -E '# wlopm$' ~/.config/swayidle/config | awk '{print \$2}'\` --field="Suspend interval (seconds)" \`grep -E '# psuspend$' ~/.config/swayidle/config | awk '{print \$2}'\`)
[ \$? -ne 0 ] && exit 1

sed -i -E -e "/# wlopm\$/ s/(timeout\\s+)[0-9]+/\\1\$wlopm_interval/" -e "/# psuspend\$/ s/(timeout\\s+)[0-9]+/\\1\$psuspend_interval/" ~/.config/swayidle/config
killall swayidle
swayidle < /dev/null > /dev/null 2>&1 &
EOF
chmod 755 usr/local/bin/swayidle-config

cat << EOF > usr/local/share/applications/swayidle-config.desktop
[Desktop Entry]
Encoding=UTF-8
Name=Screensaver Settings
Icon=user-idle-symbolic
Comment=Configure swayidle
Exec=swayidle-config
Terminal=false
Type=Application
Categories=Screensaver
GenericName=swayidle-config
EOF
chmod 644 usr/local/share/applications/swayidle-config.desktop

mkdir -p etc/skel/.config/swayidle
cat << EOF > etc/skel/.config/swayidle/config
timeout 600 'sh -c "chayang -d 7 && wlopm --off \*"' resume 'sh -c "wlopm --on \*"' # wlopm
timeout 900 psuspend # psuspend
EOF
chmod 644 etc/skel/.config/swayidle/config

cat << EOF > etc/skel/.config/autostart/swayidle.desktop
[Desktop Entry]
Version=1.0
Name=swayidle
Comment=swayidle
Exec=swayidle -w
Terminal=false
Type=Application
EOF
chmod 644 etc/skel/.config/autostart/swayidle.desktop
