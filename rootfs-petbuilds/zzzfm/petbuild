download() {
    [ -f zzzfm-antix-74aee828ead20d5f109bd395d84330b287846045.zip ] || curl --fail --retry 3 --max-time 60 -o zzzfm-antix-74aee828ead20d5f109bd395d84330b287846045.zip https://gitlab.com/antiX-Linux/zzzfm-antix/-/archive/74aee828ead20d5f109bd395d84330b287846045/zzzfm-antix-74aee828ead20d5f109bd395d84330b287846045.zip
}

build() {
    unzip -q zzzfm-antix-74aee828ead20d5f109bd395d84330b287846045.zip
    cd zzzfm-antix-74aee828ead20d5f109bd395d84330b287846045
    patch -p1 < ../fix-ftbfs-gcc14.patch
    patch -p1 < ../wayland.patch
    patch -p1 < ../mount.patch
    patch -p1 < ../puppy-defaults.patch
    patch -p1 < ../layer-shell.patch
    patch -p1 < ../gcc15.patch
    patch -p1 < ../unmount-crash.patch
    ./autogen.sh --disable-video-thumbnails --with-gtk3 --with-layer-shell
    make install
    sed -e 's/^Categories=.*/Categories=FileManager/' -i /usr/local/share/applications/zzzfm.desktop
    $CC $CFLAGS `pkg-config --cflags libudev` ../particonsd.c $LDFLAGS `pkg-config --libs libudev` -o /usr/local/bin/particonsd
}
