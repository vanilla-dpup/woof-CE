download() {
    [ -f zzzfm-antix-27070603f26b06661ed64ccbc27bfd2305596aff.zip ] || curl --fail --retry 3 --max-time 60 -o zzzfm-antix-27070603f26b06661ed64ccbc27bfd2305596aff.zip https://gitlab.com/antiX-Linux/zzzfm-antix/-/archive/27070603f26b06661ed64ccbc27bfd2305596aff/zzzfm-antix-27070603f26b06661ed64ccbc27bfd2305596aff.zip
}

build() {
    unzip -q zzzfm-antix-27070603f26b06661ed64ccbc27bfd2305596aff.zip
    cd zzzfm-antix-27070603f26b06661ed64ccbc27bfd2305596aff
    patch -p1 < ../wayland.patch
    patch -p1 < ../puppy-defaults.patch
    patch -p1 < ../layer-shell.patch
    ./autogen.sh --disable-video-thumbnails --with-gtk3 --with-layer-shell
    make install
    sed -e 's/^Categories=.*/Categories=FileManager/' -i /usr/local/share/applications/zzzfm.desktop
    $CC $CFLAGS `pkg-config --cflags libudev` ../particonsd.c $LDFLAGS `pkg-config --libs libudev` -o /usr/local/bin/particonsd
}
