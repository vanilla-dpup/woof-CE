download() {
    if [ ! -f gplaces-0.20.0.tar ]; then
        git clone https://github.com/dimkr/gplaces gplaces-0.20.0
        cd gplaces-0.20.0
        git checkout v0.20.0
        git submodule update --init --recursive
        cd ..
        rm -rf gplaces-0.20.0/.git* gplaces-0.20.0/bestline/.git*
        tar -c gplaces-0.20.0 --mtime=@0 --sort=name --owner=0 --group=0 --numeric-owner --format=ustar > gplaces-0.20.0.tar
        rm -rf gplaces-0.20.0
    fi
}

build() {
    tar -xf gplaces-0.20.0.tar
    cd gplaces-0.20.0
    make CC=gcc VERSION=0.20.0 CONFDIR=/etc install
    sed -i 's/^Categories=.*/Categories=X-Internet-utility;/' /usr/local/share/applications/gplaces.desktop
}
