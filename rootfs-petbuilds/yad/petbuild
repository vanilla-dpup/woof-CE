download() {
    [ -f yad-0.42.86.tar.gz ] || curl --fail --location --retry 3 --max-time 60 -o yad-0.42.86.tar.gz https://github.com/step-/yad/archive/refs/tags/0.42.86.tar.gz
}

build() {
    tar -xzf yad-0.42.86.tar.gz
    cd yad-0.42.86
    meson --buildtype=release build
    ninja -C build install
}